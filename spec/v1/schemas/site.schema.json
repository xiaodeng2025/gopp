{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gopp.example/schemas/v1/site.schema.json",
  "title": "GOPP v1 site",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}

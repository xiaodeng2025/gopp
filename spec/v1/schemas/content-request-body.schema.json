{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gopp.example/schemas/v1/content-request-body.schema.json",
  "title": "GOPP v1 Content Request Body",
  "type": "object",
  "required": [
    "title",
    "content"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object",
      "required": [
        "format",
        "body"
      ],
      "properties": {
        "format": {
          "const": "html"
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "content_type": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "media": {
      "type": "object",
      "properties": {
        "cover": {
          "$ref": "#/$defs/media_item"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/media_item"
          }
        }
      },
      "additionalProperties": false
    },
    "channel": {
      "$ref": "#/$defs/channel"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/http_url"
        }
      },
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "source_url": {
      "$ref": "#/$defs/http_url"
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(https://|[a-z][a-z0-9+.-]*\\.)"
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "not": {
    "required": ["source_id"]
  },
  "$defs": {
    "http_url": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$"
    },
    "media_item": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/http_url"
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "channel": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
